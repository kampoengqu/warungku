<!DOCTYPE html>
<html>
<head>
    <base target="_top">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .tab-button.active {
            border-bottom-color: #3b82f6;
            color: #3b82f6;
            font-weight: 600;
        }
    </style>
</head>
<body class="bg-gray-100 text-gray-800">

<div class="container mx-auto p-4 max-w-2xl">

    <h1 class="text-3xl font-bold text-center text-blue-600 mb-4">Kantin Pesantren Digital</h1>

    <!-- Notifikasi Global -->
    <div id="notification" class="hidden fixed top-5 right-5 bg-red-500 text-white p-4 rounded-lg shadow-lg transition-transform translate-x-full z-50">
        <p id="notification-message"></p>
    </div>

    <!-- Kontainer Tab -->
    <div class="mb-4 border-b border-gray-200">
        <nav class="flex space-x-4" aria-label="Tabs">
            <button onclick="changeTab('kasir')" id="tab-kasir" class="tab-button active py-2 px-4 border-b-2 border-transparent text-gray-500 hover:text-blue-500 hover:border-blue-500">
                Kasir
            </button>
            <button onclick="changeTab('cek-saldo')" id="tab-cek-saldo" class="tab-button py-2 px-4 border-b-2 border-transparent text-gray-500 hover:text-blue-500 hover:border-blue-500">
                Cek Saldo & Limit
            </button>
        </nav>
    </div>

    <!-- Konten Tab -->
    <div id="content-kasir" class="tab-content">
        <div class="bg-white p-6 rounded-lg shadow-md">
            <!-- Pencarian Santri -->
            <div class="mb-4">
                <label for="student-id-kasir" class="block text-sm font-medium text-gray-700 mb-1">Cari ID Santri/Pembeli</label>
                <div class="flex space-x-2">
                    <input type="text" id="student-id-kasir" class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" placeholder="Masukkan ID Santri/Pembeli...">
                    <button onclick="findStudent('kasir')" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">Cari</button>
                </div>
            </div>

            <!-- Informasi Santri -->
            <div id="student-info-kasir" class="hidden mb-4 p-4 bg-blue-50 border border-blue-100 rounded-lg">
                <p class="text-lg">Nama: <strong id="student-name-kasir" class="text-blue-800"></strong></p>
                <p>Sisa Saldo: <strong id="student-balance-kasir" class="text-green-600"></strong></p>
                <div id="spending-info-kasir">
                    <p class="text-sm text-gray-600 mt-1">Total Belanja Hari Ini: <span id="student-spending-kasir" class="font-semibold"></span></p>
                </div>
                <p id="status-info-kasir" class="hidden font-semibold text-green-600 mt-1">Status: Transaksi Tanpa Limit</p>
                <p class="text-red-500 font-bold hidden mt-1" id="limit-warning-kasir">Anda sudah mencapai batas maksimal transaksi hari ini!</p>
            </div>
            
            <div id="kasir-section" class="hidden">
                 <!-- Scanner Barcode -->
                <div class="mb-4">
                    <h3 class="text-lg font-semibold mb-2">Scan Barcode / QR Code</h3>
                    
                    <!-- Tombol Pancingan Kamera -->
                    <div id="camera-start-box" class="w-full border-2 border-dashed border-gray-300 rounded-lg p-6 text-center bg-gray-50 flex flex-col items-center justify-center space-y-3">
                        <p class="mb-1 text-sm text-gray-600 font-medium">Sistem siap. Pilih metode Scan:</p>
                        
                        <!-- Tombol Coba Kamera Web -->
                        <button onclick="startScanner()" class="w-full max-w-sm bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-4 rounded-lg shadow-md transition duration-200">
                            🎥 Coba Kamera Web (Scan Langsung)
                        </button>
                        
                        <p class="text-xs text-gray-500 mt-2">Jika tombol biru error/ditolak browser, gunakan tombol hijau:</p>
                        
                        <!-- Tombol Hijau Kamera Asli HP -->
                        <label class="w-full max-w-sm bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-4 rounded-lg shadow-md transition duration-200 cursor-pointer text-center block relative">
                            📸 Potret Barcode/QR (Pasti Berhasil)
                            <div class="text-[10px] font-normal mt-1">Klik, jepret foto barcode, lalu tekan Centang/OK</div>
                            <input type="file" accept="image/*" capture="environment" id="native-camera-input" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" onchange="handleNativeCamera(event)">
                        </label>
                    </div>

                    <!-- Kotak Video (Disembunyikan awalnya) -->
                    <div id="reader" class="w-full border-2 border-blue-300 rounded-lg overflow-hidden hidden" style="max-width: 600px; min-height: 250px;"></div>
                </div>

                <!-- Input Manual -->
                <div class="my-6">
                    <h3 class="text-lg font-semibold mb-2 border-t pt-4 text-gray-600">Atau Input Manual (Jika Scan Gagal)</h3>
                    <div class="space-y-3 p-4 bg-gray-50 rounded-lg border border-gray-200 shadow-sm">
                        <div>
                            <label for="manual-item-name" class="block text-sm font-medium text-gray-700">Nama Barang</label>
                            <input type="text" id="manual-item-name" class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" placeholder="Contoh: Roti Cokelat">
                        </div>
                        <div>
                            <label for="manual-item-price" class="block text-sm font-medium text-gray-700">Harga Satuan (Rp)</label>
                            <input type="number" id="manual-item-price" class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" placeholder="Contoh: 3000">
                        </div>
                        <button onclick="addManualItemToCart()" class="w-full bg-blue-600 text-white px-4 py-2 rounded-md font-semibold hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            + Tambah ke Keranjang
                        </button>
                    </div>
                </div>

                <!-- Keranjang Belanja -->
                <div>
                    <h3 class="text-lg font-semibold mb-2 bg-gray-100 p-2 rounded">Keranjang Belanja</h3>
                    <ul id="cart-items" class="space-y-2 mb-2">
                        <!-- Item keranjang akan ditambahkan di sini -->
                    </ul>
                    <div id="empty-cart-message" class="text-center text-gray-500 py-4 border border-dashed rounded">Keranjang masih kosong</div>
                    <hr class="my-3">
                    <div class="flex justify-between items-center font-bold text-xl px-2">
                        <span>Total:</span>
                        <span id="cart-total" class="text-blue-700">Rp 0</span>
                    </div>
                </div>

                <!-- Tombol Transaksi -->
                <div class="mt-6">
                    <button onclick="completeTransaction()" id="btn-complete-transaction" class="w-full bg-green-500 text-white py-3 rounded-lg text-lg font-bold hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 disabled:bg-gray-400" disabled>
                        Selesaikan Transaksi
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="content-cek-saldo" class="tab-content hidden">
        <div class="bg-white p-6 rounded-lg shadow-md">
            <!-- Pencarian Santri -->
             <div class="mb-4">
                <label for="student-id-saldo" class="block text-sm font-medium text-gray-700 mb-1">Masukkan ID Santri/Pembeli</label>
                <div class="flex space-x-2">
                    <input type="text" id="student-id-saldo" class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" placeholder="Masukkan ID Santri/Pembeli...">
                    <button onclick="findStudent('saldo')" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">Cek</button>
                </div>
            </div>
            
            <!-- Informasi Saldo -->
            <div id="student-info-saldo" class="hidden mt-4 p-4 bg-gray-50 border border-gray-200 rounded-lg">
                <h3 class="text-xl font-bold mb-2 text-gray-800">Informasi Akun</h3>
                <div class="space-y-2">
                    <p class="text-lg">Nama: <strong id="student-name-saldo" class="text-blue-700"></strong></p>
                    <p>Sisa Saldo: <strong id="student-balance-saldo" class="text-green-600 text-lg"></strong></p>
                    <div id="spending-info-saldo" class="bg-white p-2 rounded border mt-2">
                        <p>Total Belanja Hari Ini: <strong id="student-spending-saldo" class="text-yellow-600"></strong></p>
                        <p>Limit Harian: <strong id="student-limit-saldo"></strong></p>
                    </div>
                    <p id="status-info-saldo" class="hidden font-semibold text-green-600 bg-green-50 p-2 rounded border border-green-200">Status: Transaksi Tanpa Limit</p>
                </div>
                 <div id="limit-warning-saldo" class="hidden mt-4 p-3 bg-red-100 border border-red-400 text-red-700 rounded-md">
                    <p class="font-bold">Perhatian!</p>
                    <p>Kamu sudah mencapai batas maksimal transaksi hari ini!</p>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    // State management
    let currentStudent = null;
    let cart = [];
    let scanner = new Html5Qrcode("reader"); 
    let isCameraRunning = false; 
    let isProcessingScan = false; 

    // Utility Functions
    function showNotification(message, isError = true) {
        const notif = document.getElementById('notification');
        const notifMessage = document.getElementById('notification-message');
        notifMessage.textContent = message;
        
        notif.classList.remove('hidden', 'translate-x-full', 'bg-red-500', 'bg-green-500');
        notif.classList.add(isError ? 'bg-red-500' : 'bg-green-500');
        
        setTimeout(() => { notif.classList.remove('translate-x-full'); }, 10);
        setTimeout(() => {
            notif.classList.add('translate-x-full');
            setTimeout(() => { notif.classList.add('hidden'); }, 300);
        }, 3000);
    }

    function formatRupiah(number) {
        return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(number);
    }
    
    function startLoading(button) {
      if(button) {
        button.disabled = true;
        button.innerHTML = '<span class="animate-spin mr-2">...</span> Memproses';
      }
    }

    function stopLoading(button, defaultText) {
      if(button) {
        button.disabled = false;
        button.innerHTML = defaultText;
      }
    }

    function changeTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
        document.getElementById(`content-${tabName}`).classList.remove('hidden');

        document.querySelectorAll('.tab-button').forEach(el => el.classList.remove('active'));
        document.getElementById(`tab-${tabName}`).classList.add('active');
    }

    // Student Management
    function findStudent(context) {
        const studentId = document.getElementById(`student-id-${context}`).value;
        if (!studentId) {
            showNotification("ID Pembeli tidak boleh kosong.");
            return;
        }
        
        const button = event.target;
        startLoading(button);

        google.script.run
            .withSuccessHandler(student => {
                stopLoading(button, context === 'kasir' ? 'Cari' : 'Cek');
                if (student.error) {
                    showNotification(student.error);
                    resetKasir();
                } else {
                    currentStudent = student;
                    updateStudentInfoUI(context, student);
                    if(context === 'kasir'){
                      document.getElementById('kasir-section').classList.remove('hidden');
                    }
                }
            })
            .withFailureHandler(err => {
                stopLoading(button, context === 'kasir' ? 'Cari' : 'Cek');
                showNotification("Gagal mengambil data: " + err.message);
                resetKasir();
            })
            .getStudentInfo(studentId);
    }

    function updateStudentInfoUI(context, student) {
        document.getElementById(`student-info-${context}`).classList.remove('hidden');
        document.getElementById(`student-name-${context}`).textContent = student.name;
        document.getElementById(`student-balance-${context}`).textContent = formatRupiah(student.balance);

        const spendingInfoEl = document.getElementById(`spending-info-${context}`);
        const statusInfoEl = document.getElementById(`status-info-${context}`);
        const limitWarningEl = document.getElementById(`limit-warning-${context}`);

        if (student.isUnlimited) {
            spendingInfoEl.classList.add('hidden');
            statusInfoEl.classList.remove('hidden');
            limitWarningEl.classList.add('hidden');
        } else {
            spendingInfoEl.classList.remove('hidden');
            statusInfoEl.classList.add('hidden');

            document.getElementById(`student-spending-${context}`).textContent = formatRupiah(student.todaysSpending);
            if (context === 'saldo') {
                document.getElementById('student-limit-saldo').textContent = formatRupiah(student.limit);
            }

            if (student.todaysSpending >= student.limit) {
                limitWarningEl.classList.remove('hidden');
            } else {
                limitWarningEl.classList.add('hidden');
            }
        }
    }
    
    // Barcode Scanner Kamera Web (Biru)
    function startScanner() {
        if (!currentStudent) return;
        if (isProcessingScan) return; 

        const btnBox = document.getElementById('camera-start-box');
        const readerDiv = document.getElementById('reader');
        
        btnBox.classList.add('hidden');
        readerDiv.classList.remove('hidden');
        
        // Memperbesar qrbox menjadi kotak 250x250 agar nyaman untuk Barcode DAN QR Code
        const config = { fps: 15, qrbox: { width: 250, height: 250 }, aspectRatio: 1.0 };
        
        const onScanSuccess = (decodedText, decodedResult) => {
            if (isProcessingScan) return;
            isProcessingScan = true; 
            
            try { 
                if(isCameraRunning) scanner.pause(true); 
            } catch(e) {}
            
            handleBarcodeScan(decodedText);
        };
        
        const onScanFailure = (error) => { /* abaikan error saat sedang mencari frame */ };

        if (!isCameraRunning) {
            // Coba buka semua jenis kamera yang diizinkan tanpa paksaan menghadap belakang saja
            Html5Qrcode.getCameras().then(devices => {
                if (devices && devices.length) {
                    // Cari kamera belakang jika ada, jika tidak pakai yang pertama
                    let cameraId = devices[0].id;
                    for (let i = 0; i < devices.length; i++) {
                        if (devices[i].label.toLowerCase().includes("back") || devices[i].label.toLowerCase().includes("belakang") || devices[i].label.toLowerCase().includes("environment")) {
                            cameraId = devices[i].id;
                            break;
                        }
                    }
                    // Mulai kamera dengan ID spesifik (Metode paling stabil)
                    scanner.start(cameraId, config, onScanSuccess, onScanFailure)
                        .then(() => { isCameraRunning = true; })
                        .catch(err => forceFallbackCamera(btnBox, readerDiv));
                } else {
                    forceFallbackCamera(btnBox, readerDiv);
                }
            }).catch(err => {
                forceFallbackCamera(btnBox, readerDiv);
            });
        } else {
            try { scanner.resume(); } catch(e) {}
        }
    }

    // Fungsi paksaan jika algoritma kamera gagal
    function forceFallbackCamera(btnBox, readerDiv) {
        const config = { fps: 15, qrbox: { width: 250, height: 250 }, aspectRatio: 1.0 };
        // Paksa buka dengan facingMode environment
        scanner.start({ facingMode: "environment" }, config, 
            (text) => { if(!isProcessingScan){ isProcessingScan=true; scanner.pause(true); handleBarcodeScan(text); } }, 
            (err) => {})
        .then(() => { isCameraRunning = true; })
        .catch(err2 => {
            // Gagal total, paksa kamera user/depan
            scanner.start({ facingMode: "user" }, config, 
                (text) => { if(!isProcessingScan){ isProcessingScan=true; scanner.pause(true); handleBarcodeScan(text); } }, 
                (err) => {})
            .then(() => { isCameraRunning = true; })
            .catch(err3 => {
                console.error("Browser memblokir semua akses kamera:", err3);
                showNotification("Kamera Web Ditolak Browser. Silakan gunakan Tombol Hijau!");
                btnBox.classList.remove('hidden');
                readerDiv.classList.add('hidden');
            });
        });
    }

    // Fungsi Scan dari Jepretan Kamera Asli HP (Hijau)
    function handleNativeCamera(event) {
        const file = event.target.files[0];
        if (!file) return;

        if (isProcessingScan) return;
        isProcessingScan = true;

        showNotification("Menganalisa foto barcode/QR...", false);

        const html5QrCode = new Html5Qrcode("reader");
        
        html5QrCode.scanFile(file, true)
            .then(decodedText => {
                handleBarcodeScan(decodedText);
                event.target.value = ''; 
            })
            .catch(err => {
                showNotification("Gagal membaca! Pastikan foto barcode/QR fokus, terang, dan terlihat jelas.");
                isProcessingScan = false;
                event.target.value = ''; 
            });
    }

    function handleBarcodeScan(barcode) {
        if (!currentStudent.isUnlimited) {
            let cartTotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            if (currentStudent.todaysSpending + cartTotal >= currentStudent.limit) {
                showNotification("Sudah mencapai batas maksimal transaksi hari ini!");
                resumeScannerAfterDelay(); 
                return;
            }
        }

        google.script.run
            .withSuccessHandler(product => {
                if (product.error) {
                    showNotification(product.error);
                } else {
                    addToCart(product);
                    showNotification(`Berhasil scan: ${product.name}`, false);
                }
                resumeScannerAfterDelay();
            })
            .withFailureHandler(err => {
                showNotification("Error: " + err.message);
                resumeScannerAfterDelay();
            })
            .getProductByBarcode(barcode);
    }

    function resumeScannerAfterDelay() {
        setTimeout(() => {
            isProcessingScan = false;
            try { 
                if(isCameraRunning) scanner.resume(); 
            } catch(e) {}
        }, 1500); 
    }

    // Cart Management
    function addToCart(product) {
        if (!currentStudent.isUnlimited) {
            let cartTotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            if (currentStudent.todaysSpending + cartTotal + product.price > currentStudent.limit) {
                showNotification("Total belanja akan melebihi limit harian!");
                return;
            }
        }

        const existingItem = cart.find(item => item.barcode === product.barcode);
        if (existingItem) {
            existingItem.quantity++;
        } else {
            cart.push({ ...product, quantity: 1 });
        }
        updateCartUI();
    }

    function addManualItemToCart() {
        const itemName = document.getElementById('manual-item-name').value.trim();
        const itemPrice = parseFloat(document.getElementById('manual-item-price').value);

        if (!itemName || !itemPrice || itemPrice <= 0 || isNaN(itemPrice)) {
            showNotification("Nama barang dan harga valid harus diisi.");
            return;
        }

        const product = {
            barcode: `MANUAL-${Date.now()}`,
            name: itemName,
            price: itemPrice
        };

        addToCart(product);
        document.getElementById('manual-item-name').value = '';
        document.getElementById('manual-item-price').value = '';
        document.getElementById('manual-item-name').focus();
    }

    function updateCartUI() {
        const cartItemsEl = document.getElementById('cart-items');
        const cartTotalEl = document.getElementById('cart-total');
        const emptyCartMsg = document.getElementById('empty-cart-message');
        const completeBtn = document.getElementById('btn-complete-transaction');
        
        cartItemsEl.innerHTML = ''; 

        if (cart.length === 0) {
            emptyCartMsg.classList.remove('hidden');
            completeBtn.disabled = true;
        } else {
            emptyCartMsg.classList.add('hidden');
            completeBtn.disabled = false;
        }
        
        let total = 0;
        cart.forEach((item, index) => {
            total += item.price * item.quantity;
            const li = document.createElement('li');
            li.className = 'flex justify-between items-center p-2 bg-white border rounded shadow-sm';
            li.innerHTML = `
                <div>
                    <span class="font-medium text-gray-800">${item.name}</span>
                    <br>
                    <span class="text-sm text-gray-500">${item.quantity} x ${formatRupiah(item.price)}</span>
                </div>
                <div class="flex items-center space-x-3">
                    <span class="font-bold text-gray-700">${formatRupiah(item.price * item.quantity)}</span>
                    <button onclick="removeFromCart(${index})" class="text-red-500 hover:text-red-700 font-bold text-xl">&times;</button>
                </div>
            `;
            cartItemsEl.appendChild(li);
        });
        cartTotalEl.textContent = formatRupiah(total);
    }
    
    function removeFromCart(index) {
        cart[index].quantity--;
        if(cart[index].quantity === 0){
            cart.splice(index, 1);
        }
        updateCartUI();
    }
    
    // Transaction
    function completeTransaction() {
        if (cart.length === 0 || !currentStudent) {
            showNotification("Keranjang kosong atau pembeli belum dipilih.");
            return;
        }

        const button = document.getElementById('btn-complete-transaction');
        startLoading(button);

        google.script.run
            .withSuccessHandler(response => {
                stopLoading(button, 'Selesaikan Transaksi');
                if(response.success){
                    showNotification(response.message, false);
                    resetKasir();
                } else {
                    showNotification(response.message);
                }
            })
            .withFailureHandler(err => {
                stopLoading(button, 'Selesaikan Transaksi');
                showNotification("Gagal memproses transaksi: " + err.message);
            })
            .processTransaction(cart, currentStudent.id);
    }
    
    function resetKasir() {
        currentStudent = null;
        cart = [];
        updateCartUI();
        
        document.getElementById('student-id-kasir').value = '';
        document.getElementById('student-info-kasir').classList.add('hidden');
        document.getElementById('kasir-section').classList.add('hidden');
        
        // Kembalikan tampilan kamera ke tombol
        document.getElementById('camera-start-box').classList.remove('hidden');
        document.getElementById('reader').classList.add('hidden');
        
        if (isCameraRunning) {
            scanner.stop().then(() => {
                isCameraRunning = false;
            }).catch(err => {
                isCameraRunning = false;
            });
        }
    }
    
</script>
</body>
</html>
